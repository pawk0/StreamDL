{
  "manifest_version": 3,
  "name": "StreamDL - Video Downloader Companion",
  "version": "1.0.0",
  "description": "Detects video streams (.m3u8, .mpd, video files) and queues downloads to your local yt-dlp server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "streamdl@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "webRequest",
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:7921/*",
    "http://127.0.0.1:7921/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["utils.js", "background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "StreamDL - Download Video"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
