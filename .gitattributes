# Default: auto-detect text files and normalize line endings to LF
* text=auto eol=crlf

# Explicit text files
*.py text eol=crlf
*.json text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.toml text eol=crlf
*.html text eol=crlf
*.css text eol=crlf
*.js text eol=crlf
*.ts text eol=crlf

# Windows scripts (require CRLF to execute properly in cmd.exe)
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary files (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite3 binary
*.woff binary
*.woff2 binary
